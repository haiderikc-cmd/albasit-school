<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>نظام إدارة الجدول المدرسي - مدرسة الباسط الابتدائية للبنين</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Google Fonts (Cairo) -->
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
  
  <!-- SheetJS for Excel handling -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  
  <!-- Chart.js for analytics -->
  <script src="https://cdn.jsdelivr.net/npm/Chart.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            cairo: ['Cairo', 'sans-serif'],
          },
          colors: {
            primary: {
              50: '#f0f9ff',
              100: '#e0f2fe',
              500: '#0284c7',
              600: '#0284c7',
              700: '#0369a1',
              800: '#075985',
              900: '#0c4a6e',
            },
            accent: {
              500: '#f59e0b',
              600: '#d97706',
            }
          }
        }
      }
    }
  </script>

  <style>
    body {
      font-family: 'Cairo', sans-serif;
    }

    /* Professional Print Optimization - Full Page Fix */
    @media print {
      * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      .no-print {
        display: none !important;
      }
      .print-only {
        display: block !important;
      }
      body {
        background: white !important;
        color: #0f172a !important;
        font-size: 11px !important;
      }
      main {
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
      }
      #view-schedule {
        display: block !important;
      }
      .overflow-x-auto {
        overflow: visible !important;
      }
      table {
        width: 100% !important;
        border-collapse: collapse !important;
        table-layout: fixed !important;
      }
      th, td {
        border: 1px solid #334155 !important;
        padding: 6px 4px !important;
        text-align: center !important;
        font-size: 11px !important;
        word-wrap: break-word !important;
      }
      thead th {
        background-color: #0f172a !important;
        color: white !important;
      }
      .break-row-print {
        background-color: #fef3c7 !important;
        color: #92400e !important;
        font-weight: bold !important;
      }
      @page {
        size: A4 landscape;
        margin: 1cm;
      }
    }

    .print-only {
      display: none;
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col font-cairo selection:bg-sky-500 selection:text-white" oncontextmenu="return false;">

  <!-- Header Section -->
  <header class="bg-gradient-to-r from-sky-900 via-sky-800 to-indigo-900 text-white shadow-xl no-print relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
    
    <div class="container mx-auto px-4 py-4 relative z-10 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-14 h-14 bg-white/10 backdrop-blur-md rounded-2xl flex items-center justify-center border border-white/20 shadow-inner">
          <i class="fa-solid fa-school text-2xl text-amber-400"></i>
        </div>
        <div>
          <h1 class="text-2xl font-black tracking-wide flex items-center gap-2">
            مدرسة الباسط الابتدائية للبنين
            <span class="text-xs font-normal bg-amber-500/20 text-amber-300 border border-amber-400/30 px-2 py-0.5 rounded-full">النسخة الاحترافية المحدثة</span>
          </h1>
          <p class="text-xs text-sky-200 mt-0.5 flex items-center gap-2">
            <span><i class="fa-solid fa-code text-amber-400"></i> إعداد وتطوير: <strong>حيدر صباح الطليباوي</strong></span>
            <span class="opacity-50">•</span>
            <span><i class="fa-solid fa-phone text-emerald-400"></i> <strong>07706509284</strong></span>
          </p>
        </div>
      </div>

      <!-- Manager Info Badge (Top Left) -->
      <div class="bg-white/10 backdrop-blur-md border border-white/20 px-4 py-2 rounded-2xl text-right shadow-inner">
        <div class="text-xs text-amber-300 font-bold"><i class="fa-solid fa-user-shield ml-1"></i> إدارة المدرسة</div>
        <div class="text-sm font-black text-white">عباس جاسم محمد</div>
        <div class="text-xs text-emerald-300 font-mono"><i class="fa-solid fa-phone-volume ml-1"></i> 07707335927</div>
      </div>
    </div>

    <!-- Quick Action Navigation Bar -->
    <div class="bg-black/20 backdrop-blur-md border-t border-white/10 px-4 py-2">
      <div class="container mx-auto flex items-center justify-between flex-wrap gap-2">
        <nav class="flex items-center gap-2 text-sm flex-wrap">
          <button onclick="switchTab('schedule')" id="btn-schedule" class="px-4 py-2 rounded-xl font-bold transition flex items-center gap-2 bg-amber-500 text-slate-900 shadow-md">
            <i class="fa-solid fa-calendar-days"></i> الجدول الدراسي
          </button>
          <button onclick="switchTab('tv')" id="btn-tv" class="px-4 py-2 rounded-xl font-bold transition flex items-center gap-2 text-white hover:bg-white/10">
            <i class="fa-solid fa-tv"></i> البث المباشر (TV)
          </button>
          <button onclick="switchTab('settings')" id="btn-settings" class="px-4 py-2 rounded-xl font-bold transition flex items-center gap-2 text-white hover:bg-white/10">
            <i class="fa-solid fa-sliders"></i> الصفوف والأوقات
          </button>
          <button onclick="switchTab('staff')" id="btn-staff" class="px-4 py-2 rounded-xl font-bold transition flex items-center gap-2 text-white hover:bg-white/10">
            <i class="fa-solid fa-users-gear"></i> إدارة الكادر
          </button>
          <button onclick="switchTab('absence')" id="btn-absence" class="px-4 py-2 rounded-xl font-bold transition flex items-center gap-2 text-white hover:bg-white/10">
            <i class="fa-solid fa-user-clock"></i> الغياب والاحتياط
          </button>
          <button onclick="switchTab('analytics')" id="btn-analytics" class="px-4 py-2 rounded-xl font-bold transition flex items-center gap-2 text-white hover:bg-white/10">
            <i class="fa-solid fa-chart-pie"></i> الإحصائيات
          </button>
        </nav>

        <!-- Backup & Sync Tools -->
        <div class="flex items-center gap-2">
          <button onclick="exportBackup()" class="bg-sky-600 hover:bg-sky-500 text-white px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 transition shadow" title="تصدير نسخة احتياطية لنقلها للهاتف أو حاسوب آخر">
            <i class="fa-solid fa-cloud-arrow-down"></i> تصدير البيانات
          </button>
          <label class="bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 transition shadow cursor-pointer" title="استعادة البيانات من ملف الاحتياط">
            <i class="fa-solid fa-cloud-arrow-up"></i> استيراد البيانات
            <input type="file" id="backup-file-input" accept=".json" onchange="importBackup(event)" class="hidden">
          </label>
        </div>
      </div>
    </div>
  </header>

  <!-- Live Status Bar -->
  <div class="bg-slate-800 text-white border-b border-slate-700 py-2.5 px-4 no-print text-sm shadow-inner">
    <div class="container mx-auto flex flex-wrap justify-between items-center gap-4">
      <div class="flex items-center gap-6">
        <div class="flex items-center gap-2 text-amber-400 font-bold font-mono">
          <i class="fa-regular fa-clock animate-pulse"></i>
          <span id="live-time-display">00:00:00 AM</span>
        </div>
        <div id="current-period-badge" class="bg-sky-500/20 text-sky-300 border border-sky-500/30 px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-2">
          <i class="fa-solid fa-spinner fa-spin"></i> مراقبة الحصص الزمنية...
        </div>
      </div>

      <div class="flex items-center gap-3">
        <button onclick="toggleBellSound()" id="bell-toggle-btn" class="bg-slate-700 hover:bg-slate-600 text-slate-200 px-3 py-1 rounded-lg text-xs font-semibold flex items-center gap-2 transition">
          <i class="fa-solid fa-bell"></i> التنبيه الصوتي: <span id="bell-status" class="text-emerald-400">مفعل</span>
        </button>
        <button onclick="window.print()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 transition shadow">
          <i class="fa-solid fa-print"></i> طباعة الجدول (A4)
        </button>
      </div>
    </div>
  </div>

  <!-- Print Header Only (Official & Formal) -->
  <div class="print-only text-center mb-4 pb-3 border-b-2 border-slate-900">
    <div class="flex justify-between items-center text-xs text-slate-700 mb-1 font-bold">
      <span>جمهورية العراق - وزارة التربية</span>
      <span>مديرية تربية البصرة</span>
    </div>
    <div class="flex justify-between items-center text-xs text-slate-700 mb-2 font-bold">
      <span>مدرسة الباسط الابتدائية للبنين</span>
      <span>مدير المدرسة: عباس جاسم محمد (07707335927)</span>
    </div>
    <h1 class="text-xl font-black text-slate-900 mt-2">الجدول الدراسي العام المعتمد</h1>
    <div class="flex justify-between items-center text-[10px] text-slate-600 mt-2 pt-1 border-t border-slate-300">
      <span>تاريخ الطباعة: <strong id="print-date"></strong></span>
      <span>هندسة وتطوير البرمجيات: حيدر صباح الطليباوي (07706509284)</span>
    </div>
  </div>

  <!-- Main Container -->
  <main class="container mx-auto px-4 py-6 flex-grow">

    <!-- View 1: Main Schedule View -->
    <section id="view-schedule" class="space-y-6">
      
      <!-- Filter & Action Controls -->
      <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200 no-print flex flex-wrap justify-between items-center gap-4">
        
        <div class="flex flex-wrap items-center gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-500 mb-1">الصف والشعبة:</label>
            <select id="grade-filter" onchange="renderSchedule()" class="bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm font-bold focus:ring-2 focus:ring-sky-500 outline-none">
              <!-- Dynamically Loaded -->
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-500 mb-1">فلترة حسب اليوم:</label>
            <select id="day-filter" onchange="renderSchedule()" class="bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm font-bold focus:ring-2 focus:ring-sky-500 outline-none">
              <option value="ALL">جميع أيام الأسبوع</option>
              <option value="الأحد">الأحد</option>
              <option value="الإثنين">الإثنين</option>
              <option value="الثلاثاء">الثلاثاء</option>
              <option value="الأربعاء">الأربعاء</option>
              <option value="الخميس">الخميس</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-500 mb-1">بحث موجه:</label>
            <div class="relative">
              <input type="text" id="search-input" onkeyup="renderSchedule()" placeholder="اسم المعلم أو المادة..." class="bg-slate-50 border border-slate-300 rounded-xl pr-9 pl-3 py-2 text-sm font-semibold focus:ring-2 focus:ring-sky-500 outline-none w-48">
              <i class="fa-solid fa-search absolute right-3 top-3 text-slate-400 text-xs"></i>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button onclick="openModal('period-modal')" class="bg-sky-600 hover:bg-sky-700 text-white px-4 py-2 rounded-xl text-sm font-bold flex items-center gap-2 shadow-sm transition">
            <i class="fa-solid fa-plus"></i> إضافة حصة
          </button>
          <button onclick="autoScheduleGen()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-xl text-sm font-bold flex items-center gap-2 shadow-sm transition" title="فحص التعارضات التلقائي">
            <i class="fa-solid fa-wand-magic-sparkles"></i> فحص التعارضات
          </button>
          <button onclick="resetAllScheduleData()" class="bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 px-3 py-2 rounded-xl text-sm font-bold transition" title="تفريغ الجدول">
            <i class="fa-solid fa-trash-can"></i>
          </button>
        </div>

      </div>

      <!-- Main Schedule Grid Table -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-center border-collapse">
            <thead>
              <tr id="schedule-thead-row" class="bg-slate-800 text-white text-sm">
                <!-- Dynamic Header -->
              </tr>
            </thead>
            <tbody id="schedule-tbody" class="divide-y divide-slate-200 text-sm">
              <!-- Dynamic Rows -->
            </tbody>
          </table>
        </div>
      </div>

    </section>

    <!-- View 2: Settings (Classes, Periods Timings 12-hour & Breaks Management) -->
    <section id="view-settings" class="hidden space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- Manage Classes & Sections (Strictly Ordered) -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 space-y-4">
          <div class="flex justify-between items-center border-b pb-3">
            <div>
              <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-layer-group text-sky-600"></i> تنظيم الصفوف والشعب (من الأول للسادس)
              </h3>
              <p class="text-xs text-slate-500 mt-0.5">الشعب الافتراضية مرتبة أبجدياً وتدريجياً</p>
            </div>
            <button onclick="openAddClassModal()" class="bg-sky-600 hover:bg-sky-700 text-white px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 shadow transition">
              <i class="fa-solid fa-plus"></i> إضافة شعبة
            </button>
          </div>

          <div id="classes-list-container" class="space-y-2 max-h-96 overflow-y-auto pl-1">
            <!-- Dynamic Classes List -->
          </div>
        </div>

        <!-- Manage Periods 12-Hour Timings & Breaks -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 space-y-4">
          <div class="flex justify-between items-center border-b pb-3">
            <div>
              <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-clock text-amber-500"></i> توقيتات الحصص والاستراحات (12 ساعة)
              </h3>
              <p class="text-xs text-slate-500 mt-0.5">إدارة الحصص وإدخال الاستراحات المتعددة (الأولى، الثانية...)</p>
            </div>
            <button onclick="openModal('break-modal')" class="bg-amber-600 hover:bg-amber-700 text-white px-3 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1.5 shadow transition">
              <i class="fa-solid fa-mug-hot"></i> إضافة استراحة
            </button>
          </div>

          <div id="periods-timing-container" class="space-y-3">
            <!-- Dynamic Timing & Breaks Controls -->
          </div>
        </div>

      </div>
    </section>

    <!-- View 3: Live TV Mode -->
    <section id="view-tv" class="hidden space-y-6">
      <div class="bg-slate-900 text-white rounded-3xl p-8 border border-slate-800 shadow-2xl relative overflow-hidden text-center">
        <div class="inline-block bg-sky-500/10 text-sky-400 border border-sky-500/20 px-4 py-1.5 rounded-full text-xs font-bold mb-4">
          <i class="fa-solid fa-satellite-dish animate-pulse"></i> شاشة العرض المباشرة لغرفة المعلمين والإدارة
        </div>
        
        <h2 id="tv-current-day-title" class="text-4xl font-black mb-2 text-amber-400">اليوم: الأحد</h2>
        <div id="tv-countdown-box" class="text-6xl font-black font-mono my-6 tracking-widest text-white">00:00 AM</div>
        <p id="tv-status-text" class="text-xl text-slate-300">الحصة الحالية: <span class="text-emerald-400 font-bold">الحصة الأولى</span></p>

        <!-- Current Ongoing Classes Grid -->
        <div class="mt-10">
          <h3 class="text-lg font-bold text-slate-400 mb-4 text-right border-b border-slate-800 pb-2">الحصص القائمة الآن في جميع الشعب:</h3>
          <div id="tv-active-classes-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-right">
            <!-- Rendered Live -->
          </div>
        </div>
      </div>
    </section>

    <!-- View 4: Staff Management & Excel View -->
    <section id="view-staff" class="hidden space-y-6">
      
      <!-- Staff Control Header -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 flex flex-wrap justify-between items-center gap-4">
        <div>
          <h2 class="text-xl font-bold text-slate-800 flex items-center gap-2">
            <i class="fa-solid fa-id-card text-sky-600"></i> دليل الكادر التدريسي والاستيراد
          </h2>
          <p class="text-xs text-slate-500 mt-1">إدارة أساتذة المدرسة، تخصصاتهم، واستيراد وتصدير بياناتهم عبر ملفات Excel</p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button onclick="exportStaffToExcel()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-xl text-sm font-bold flex items-center gap-2 transition shadow-sm">
            <i class="fa-solid fa-file-excel"></i> تصدير Excel
          </button>
          
          <label class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-xl text-sm font-bold flex items-center gap-2 transition shadow-sm cursor-pointer">
            <i class="fa-solid fa-file-import"></i> استيراد Excel
            <input type="file" id="excel-file-input" accept=".xlsx, .xls, .csv" onchange="importStaffFromExcel(event)" class="hidden">
          </label>

          <button onclick="openModal('staff-modal')" class="bg-sky-600 hover:bg-sky-700 text-white px-4 py-2 rounded-xl text-sm font-bold flex items-center gap-2 transition shadow-sm">
            <i class="fa-solid fa-user-plus"></i> إضافة معلم جديد
          </button>
        </div>
      </div>

      <!-- Staff Grid -->
      <div id="staff-cards-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <!-- Rendered Dynamically -->
      </div>

    </section>

    <!-- View 5: Absence & Substitutions -->
    <section id="view-absence" class="hidden space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Record Absence Form -->
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 space-y-4">
          <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
            <i class="fa-solid fa-user-minus text-rose-500"></i> تسجيل غياب معلم اليوم
          </h3>
          <p class="text-xs text-slate-500">اختر المعلم الغائب ليقوم النظام باقتراح البدلاء المتاحين تلقائياً.</p>

          <form onsubmit="handleAbsenceSubmit(event)" class="space-y-4">
            <div>
              <label class="block text-xs font-bold text-slate-600 mb-1">المعلم الغائب:</label>
              <select id="absent-teacher-select" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm font-bold focus:ring-2 focus:ring-sky-500 outline-none">
                <!-- Loaded dynamically -->
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-600 mb-1">سبب الغياب / ملاحظة:</label>
              <input type="text" id="absence-reason" placeholder="إجازة مرضية، إيفاد..." class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm outline-none">
            </div>

            <button type="submit" class="w-full bg-rose-600 hover:bg-rose-700 text-white font-bold py-2.5 rounded-xl transition shadow">
              تسجيل الغياب واقتراح البدلاء
            </button>
          </form>
        </div>

        <!-- Substitutions Recommendations -->
        <div class="lg:col-span-2 bg-white rounded-2xl p-6 shadow-sm border border-slate-200 space-y-4">
          <h3 class="text-lg font-bold text-slate-800 flex items-center gap-2">
            <i class="fa-solid fa-people-arrows text-indigo-600"></i> مقترحات جدول الاحتياط وتغطية الحصص
          </h3>
          <div id="substitutions-list" class="space-y-3">
            <p class="text-sm text-slate-500 italic text-center py-8">قم بتسجيل معلم غائب لعرض الحصص المتأثرة والبدلاء المناسبين لكل حصة.</p>
          </div>
        </div>

      </div>
    </section>

    <!-- View 6: Analytics Dashboard (Fixed & Persistent) -->
    <section id="view-analytics" class="hidden space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
          <h3 class="text-lg font-bold mb-4 text-slate-800"><i class="fa-solid fa-chart-pie text-sky-600"></i> توزيع الحصص الأسبوعية حسب المادة</h3>
          <div class="relative h-72"><canvas id="chart-subjects"></canvas></div>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
          <h3 class="text-lg font-bold mb-4 text-slate-800"><i class="fa-solid fa-chart-bar text-indigo-600"></i> النصاب الأسبوعي للمعلمين (عدد الحصص)</h3>
          <div class="relative h-72"><canvas id="chart-teachers"></canvas></div>
        </div>
      </div>
    </section>

  </main>

  <!-- Modals -->

  <!-- Add/Edit Class Modal -->
  <div id="class-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-2xl relative space-y-4">
      <div class="flex justify-between items-center border-b pb-3">
        <h3 id="class-modal-title" class="text-lg font-bold text-slate-800">إضافة صف / شعبة جديدة</h3>
        <button onclick="closeModal('class-modal')" class="text-slate-400 hover:text-slate-600 text-lg"><i class="fa-solid fa-xmark"></i></button>
      </div>

      <form onsubmit="saveClass(event)" class="space-y-3">
        <div>
          <label class="block text-xs font-bold text-slate-600 mb-1">اسم الصف والشعبة:</label>
          <input type="text" id="class-name-input" required placeholder="مثال: الأول (ج)" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm font-semibold outline-none focus:ring-2 focus:ring-sky-500">
        </div>

        <div class="pt-3 flex gap-2">
          <button type="submit" class="flex-1 bg-sky-600 hover:bg-sky-700 text-white font-bold py-2 rounded-xl text-sm transition">حفظ الشعبة</button>
          <button type="button" onclick="closeModal('class-modal')" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold px-4 py-2 rounded-xl text-sm transition">إلغاء</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Add Break Modal -->
  <div id="break-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-2xl relative space-y-4">
      <div class="flex justify-between items-center border-b pb-3">
        <h3 class="text-lg font-bold text-slate-800">إضافة استراحة جديدة</h3>
        <button onclick="closeModal('break-modal')" class="text-slate-400 hover:text-slate-600 text-lg"><i class="fa-solid fa-xmark"></i></button>
      </div>

      <form onsubmit="saveBreak(event)" class="space-y-3">
        <div>
          <label class="block text-xs font-bold text-slate-600 mb-1">اسم الاستراحة:</label>
          <input type="text" id="break-name-input" required placeholder="مثال: الاستراحة الأولى، فرصة الصلاة..." class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm font-semibold">
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 mb-1">الوقت (أو توقيت الاستراحة):</label>
          <input type="text" id="break-time-input" required placeholder="مثال: 10:25 ص - 10:45 ص" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm font-semibold">
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 mb-1">تأتي بعد الحصة رقم:</label>
          <select id="break-after-period" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm font-semibold">
            <option value="1">الحصة الأولى</option>
            <option value="2">الحصة الثانية</option>
            <option value="3" selected>الحصة الثالثة</option>
            <option value="4">الحصة الرابعة</option>
            <option value="5">الحصة الخامسة</option>
          </select>
        </div>

        <div class="pt-3 flex gap-2">
          <button type="submit" class="flex-1 bg-amber-600 hover:bg-amber-700 text-white font-bold py-2 rounded-xl text-sm transition">حفظ الاستراحة</button>
          <button type="button" onclick="closeModal('break-modal')" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold px-4 py-2 rounded-xl text-sm transition">إلغاء</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Add/Edit Period Modal -->
  <div id="period-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl relative space-y-4">
      <div class="flex justify-between items-center border-b pb-3">
        <h3 class="text-lg font-bold text-slate-800">تخصيص حصة دراسية</h3>
        <button onclick="closeModal('period-modal')" class="text-slate-400 hover:text-slate-600 text-lg"><i class="fa-solid fa-xmark"></i></button>
      </div>

      <form onsubmit="savePeriod(event)" class="space-y-3">
        <div>
          <label class="block text-xs font-bold text-slate-600 mb-1">اليوم:</label>
          <select id="modal-day" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm font-semibold">
            <option value="الأحد">الأحد</option>
            <option value="الإثنين">الإثنين</option>
            <option value="الثلاثاء">الثلاثاء</option>
            <option value="الأربعاء">الأربعاء</option>
            <option value="الخميس">الخميس</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-600 mb-1">الحصة:</label>
            <select id="modal-period-num" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm font-semibold">
              <!-- Dynamically Populated -->
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-600 mb-1">الصف والشعبة:</label>
            <select id="modal-grade" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm font-semibold">
              <!-- Dynamically Populated -->
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 mb-1">المادة الدراسية:</label>
          <select id="modal-subject" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm font-semibold">
            <option value="القرآن الكريم والتربية الإسلامية">القرآن الكريم والتربية الإسلامية</option>
            <option value="اللغة العربية">اللغة العربية</option>
            <option value="القراءة">القراءة</option>
            <option value="التربية الأخلاقية">التربية الأخلاقية</option>
            <option value="الرياضيات">الرياضيات</option>
            <option value="العلوم">العلوم</option>
            <option value="اللغة الإنكليزية">اللغة الإنكليزية</option>
            <option value="الاجتماعيات">الاجتماعيات</option>
            <option value="التربية الرياضية">التربية الرياضية</option>
            <option value="التربية الفنية">التربية الفنية</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 mb-1">المعلم:</label>
          <select id="modal-teacher" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm font-semibold">
            <!-- Dynamically filled -->
          </select>
        </div>

        <div class="pt-3 flex gap-2">
          <button type="submit" class="flex-1 bg-sky-600 hover:bg-sky-700 text-white font-bold py-2 rounded-xl text-sm transition">حفظ الحصة</button>
          <button type="button" onclick="closeModal('period-modal')" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold px-4 py-2 rounded-xl text-sm transition">إلغاء</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Add Staff Modal -->
  <div id="staff-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl relative space-y-4">
      <div class="flex justify-between items-center border-b pb-3">
        <h3 class="text-lg font-bold text-slate-800">إضافة معلم جديد للكادر</h3>
        <button onclick="closeModal('staff-modal')" class="text-slate-400 hover:text-slate-600 text-lg"><i class="fa-solid fa-xmark"></i></button>
      </div>

      <form onsubmit="saveStaffMember(event)" class="space-y-3">
        <div>
          <label class="block text-xs font-bold text-slate-600 mb-1">اسم المعلم الثلاثي:</label>
          <input type="text" id="staff-name" required placeholder="أ. أحمد علي..." class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm">
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 mb-1">التخصص / المادة الرئيسية:</label>
          <input type="text" id="staff-subject" required placeholder="اللغة العربية..." class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm">
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-600 mb-1">رقم الهاتف (اختياري):</label>
          <input type="text" id="staff-phone" placeholder="0770xxxxxxx" class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 text-sm">
        </div>

        <div class="pt-3 flex gap-2">
          <button type="submit" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 rounded-xl text-sm transition">حفظ المعلم</button>
          <button type="button" onclick="closeModal('staff-modal')" class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold px-4 py-2 rounded-xl text-sm transition">إلغاء</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Footer Section -->
  <footer class="bg-slate-900 text-slate-400 py-6 border-t border-slate-800 text-center text-xs no-print mt-auto">
    <div class="container mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-3">
      <div>
        <p class="font-bold text-slate-300">مدرسة الباسط الابتدائية للبنين | مدير المدرسة: عباس جاسم محمد © 2026</p>
        <p class="text-slate-500 mt-0.5">نظام إدارة الجداول المدرسية الاحترافي</p>
      </div>
      <div class="bg-slate-800 px-4 py-2 rounded-xl border border-slate-700 text-amber-400 font-semibold">
        <i class="fa-solid fa-shield-halved"></i> هندسة البرمجيات: <span class="text-white">حيدر صباح الطليباوي</span> | <span class="text-emerald-400">07706509284</span>
      </div>
    </div>
  </footer>

  <!-- Application Logic JS -->
  <script>
    let classes = JSON.parse(localStorage.getItem('albasit_classes')) || [
      { id: 'c1', name: 'الأول (أ)' },
      { id: 'c2', name: 'الأول (ب)' },
      { id: 'c3', name: 'الثاني (أ)' },
      { id: 'c4', name: 'الثاني (ب)' },
      { id: 'c5', name: 'الثالث (أ)' },
      { id: 'c6', name: 'الثالث (ب)' },
      { id: 'c7', name: 'الرابع (أ)' },
      { id: 'c8', name: 'الرابع (ب)' },
      { id: 'c9', name: 'الخامس (أ)' },
      { id: 'c10', name: 'الخامس (ب)' },
      { id: 'c11', name: 'السادس (أ)' },
      { id: 'c12', name: 'السادس (ب)' }
    ];

    let periods = JSON.parse(localStorage.getItem('albasit_periods')) || [
      { num: 1, name: 'الحصة الأولى', start: '08:00 ص', end: '08:45 ص' },
      { num: 2, name: 'الحصة الثانية', start: '08:50 ص', end: '09:35 ص' },
      { num: 3, name: 'الحصة الثالثة', start: '09:40 ص', end: '10:25 ص' },
      { num: 4, name: 'الحصة الرابعة', start: '10:45 ص', end: '11:30 ص' },
      { num: 5, name: 'الحصة الخامسة', start: '11:35 ص', end: '12:20 م' },
      { num: 6, name: 'الحصة السادسة', start: '12:25 م', end: '01:10 م' }
    ];

    let breaks = JSON.parse(localStorage.getItem('albasit_breaks')) || [
      { id: 'b1', name: 'الاستراحة الأولى', time: '10:25 ص - 10:45 ص', afterPeriod: 3 }
    ];

    let teachers = JSON.parse(localStorage.getItem('albasit_teachers')) || [
      { id: 't1', name: 'أ. جاسم محمد', subject: 'اللغة العربية', phone: '07701112233' },
      { id: 't2', name: 'أ. علاء حسين', subject: 'الرياضيات', phone: '07702223344' },
      { id: 't3', name: 'أ. حسن كاظم', subject: 'العلوم', phone: '07703334455' },
      { id: 't4', name: 'أ. عمار فاضل', subject: 'اللغة الإنكليزية', phone: '07704445566' },
      { id: 't5', name: 'أ. مرتضى حيدر', subject: 'القرآن الكريم والتربية الإسلامية', phone: '07705556677' },
      { id: 't6', name: 'أ. عباس مهدي', subject: 'الاجتماعيات', phone: '07706667788' },
      { id: 't7', name: 'أ. سعد جبار', subject: 'التربية الرياضية', phone: '07707778899' },
      { id: 't8', name: 'أ. علي الساعدي', subject: 'التربية الفنية', phone: '07708889900' }
    ];

    let schedule = JSON.parse(localStorage.getItem('albasit_schedule')) || [
      { id: 's1', day: 'الأحد', periodNum: 1, grade: 'الأول (أ)', subject: 'القرآن الكريم والتربية الإسلامية', teacherId: 't5' },
      { id: 's2', day: 'الأحد', periodNum: 1, grade: 'الخامس (أ)', subject: 'الرياضيات', teacherId: 't2' }
    ];

    let isBellActive = true;
    let chartSubjectsInstance = null;
    let chartTeachersInstance = null;
    const daysOfWeek = ['الأحد', 'الإثنين', 'الثلاثاء', 'الأربعاء', 'الخميس'];

    function saveData() {
      localStorage.setItem('albasit_classes', JSON.stringify(classes));
      localStorage.setItem('albasit_periods', JSON.stringify(periods));
      localStorage.setItem('albasit_breaks', JSON.stringify(breaks));
      localStorage.setItem('albasit_teachers', JSON.stringify(teachers));
      localStorage.setItem('albasit_schedule', JSON.stringify(schedule));
    }

    function exportBackup() {
      const backupData = { classes, periods, breaks, teachers, schedule };
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(backupData));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", "albasit_school_backup.json");
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    }

    function importBackup(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(evt) {
        try {
          const parsed = JSON.parse(evt.target.result);
          if (parsed.classes && parsed.periods && parsed.teachers && parsed.schedule) {
            classes = parsed.classes;
            periods = parsed.periods;
            breaks = parsed.breaks || [];
            teachers = parsed.teachers;
            schedule = parsed.schedule;
            saveData();
            populateModalDropdowns();
            renderSchedule();
            alert("تم استعادة كافة البيانات بنجاح تام وتزامن الجدول مع جهازك!");
          } else {
            alert("ملف الاحتياط غير صالح.");
          }
        } catch(err) {
          alert("خطأ في قراءة الملف.");
        }
      };
      reader.readAsText(file);
    }

    function switchTab(tabId) {
      const tabs = ['schedule', 'tv', 'settings', 'staff', 'absence', 'analytics'];
      tabs.forEach(tab => {
        const view = document.getElementById(`view-${tab}`);
        const btn = document.getElementById(`btn-${tab}`);
        if (view && btn) {
          if (tab === tabId) {
            view.classList.remove('hidden');
            btn.className = "px-4 py-2 rounded-xl font-bold transition flex items-center gap-2 bg-amber-500 text-slate-900 shadow-md";
          } else {
            view.classList.add('hidden');
            btn.className = "px-4 py-2 rounded-xl font-bold transition flex items-center gap-2 text-white hover:bg-white/10";
          }
        }
      });

      if (tabId === 'schedule') renderSchedule();
      if (tabId === 'settings') renderSettings();
      if (tabId === 'staff') renderStaff();
      if (tabId === 'absence') renderAbsenceView();
      if (tabId === 'analytics') renderAnalytics();
      if (tabId === 'tv') renderTVView();
    }

    function openModal(modalId) {
      const modal = document.getElementById(modalId);
      if (modal) {
        modal.classList.remove('hidden');
        populateModalDropdowns();
      }
    }

    function closeModal(modalId) {
      const modal = document.getElementById(modalId);
      if (modal) modal.classList.add('hidden');
    }

    function populateModalDropdowns() {
      const teacherSelect = document.getElementById('modal-teacher');
      const gradeSelect = document.getElementById('modal-grade');
      const periodNumSelect = document.getElementById('modal-period-num');
      const gradeFilter = document.getElementById('grade-filter');

      if (teacherSelect) {
        teacherSelect.innerHTML = teachers.map(t => `<option value="${t.id}">${t.name} (${t.subject})</option>`).join('');
      }

      if (gradeSelect) {
        gradeSelect.innerHTML = classes.map(c => `<option value="${c.name}">${c.name}</option>`).join('');
      }

      if (periodNumSelect) {
        periodNumSelect.innerHTML = periods.map(p => `<option value="${p.num}">${p.name} (${p.start} - ${p.end})</option>`).join('');
      }

      if (gradeFilter) {
        const currentVal = gradeFilter.value;
        gradeFilter.innerHTML = `<option value="ALL">جميع الصفوف والشعب</option>` + 
          classes.map(c => `<option value="${c.name}">${c.name}</option>`).join('');
        gradeFilter.value = currentVal || 'ALL';
      }
    }

    function renderSchedule() {
      const tbody = document.getElementById('schedule-tbody');
      const theadRow = document.getElementById('schedule-thead-row');
      const selectedGrade = document.getElementById('grade-filter').value || 'ALL';
      const selectedDay = document.getElementById('day-filter').value || 'ALL';
      const searchQuery = document.getElementById('search-input').value.trim().toLowerCase();

      // Build Dynamic Header with Breaks integrated
      let headerHTML = `<th class="p-3 border-b border-slate-700 bg-slate-900 text-amber-400 font-extrabold w-28">اليوم / الحصة</th>`;
      
      periods.forEach((p, idx) => {
        headerHTML += `
          <th class="p-3 border-b border-slate-700 bg-slate-800 font-bold">
            <div>${p.name}</div>
            <div class="text-[10px] font-normal text-sky-300 mt-0.5 font-mono">${p.start} - ${p.end}</div>
          </th>
        `;
        
        // Check if there is a break after this period
        const matchingBreak = breaks.find(b => parseInt(b.afterPeriod) === p.num);
        if (matchingBreak) {
          headerHTML += `
            <th class="p-3 border-b border-amber-700 bg-amber-900 text-amber-200 font-bold">
              <div><i class="fa-solid fa-mug-hot ml-1"></i> ${matchingBreak.name}</div>
              <div class="text-[10px] font-normal text-amber-300 mt-0.5 font-mono">${matchingBreak.time}</div>
            </th>
          `;
        }
      });
      theadRow.innerHTML = headerHTML;

      const displayDays = selectedDay === 'ALL' ? daysOfWeek : [selectedDay];
      let rowsHTML = '';

      displayDays.forEach(day => {
        rowsHTML += `<tr class="border-b border-slate-200 hover:bg-slate-50 transition">`;
        rowsHTML += `<td class="p-3 font-black bg-slate-100 text-slate-800 border-l border-slate-200">${day}</td>`;

        periods.forEach((p, idx) => {
          let items = schedule.filter(s => s.day === day && s.periodNum === p.num);

          if (selectedGrade !== 'ALL') {
            items = items.filter(s => s.grade === selectedGrade);
          }

          if (searchQuery) {
            items = items.filter(s => {
              const teacher = teachers.find(t => t.id === s.teacherId);
              const teacherName = teacher ? teacher.name.toLowerCase() : '';
              return s.subject.toLowerCase().includes(searchQuery) || teacherName.includes(searchQuery) || s.grade.toLowerCase().includes(searchQuery);
            });
          }

          rowsHTML += `<td class="p-2 border-l border-slate-200 align-top">`;
          if (items.length > 0) {
            items.forEach(item => {
              const teacher = teachers.find(t => t.id === item.teacherId) || { name: 'غير محدد' };
              rowsHTML += `
                <div class="bg-sky-50 border border-sky-200 rounded-xl p-2 mb-1 shadow-sm text-right relative group">
                  <div class="font-bold text-sky-950 text-xs flex justify-between items-center">
                    <span>${item.grade}</span>
                    <button onclick="deletePeriod('${item.id}')" class="text-rose-500 opacity-0 group-hover:opacity-100 transition text-xs hover:text-rose-700 no-print"><i class="fa-solid fa-trash"></i></button>
                  </div>
                  <div class="text-slate-800 font-extrabold text-sm mt-0.5">${item.subject}</div>
                  <div class="text-xs text-slate-600 mt-1 flex items-center gap-1">
                    <i class="fa-solid fa-user-tie text-sky-600 text-[10px]"></i> ${teacher.name}
                  </div>
                </div>
              `;
            });
          } else {
            rowsHTML += `<span class="text-xs text-slate-300 italic">-</span>`;
          }
          rowsHTML += `</td>`;

          // Check for Break Column Cell
          const matchingBreak = breaks.find(b => parseInt(b.afterPeriod) === p.num);
          if (matchingBreak) {
            rowsHTML += `
              <td class="p-2 border-l border-amber-200 bg-amber-50/60 align-middle text-center break-row-print">
                <div class="font-black text-amber-900 text-xs"><i class="fa-solid fa-mug-hot"></i> ${matchingBreak.name}</div>
                <div class="text-[10px] text-amber-700 font-mono mt-1">${matchingBreak.time}</div>
              </td>
            `;
          }
        });
        rowsHTML += `</tr>`;
      });

      tbody.innerHTML = rowsHTML;
    }

    function savePeriod(e) {
      e.preventDefault();
      const day = document.getElementById('modal-day').value;
      const periodNum = parseInt(document.getElementById('modal-period-num').value);
      const grade = document.getElementById('modal-grade').value;
      const subject = document.getElementById('modal-subject').value;
      const teacherId = document.getElementById('modal-teacher').value;

      const conflict = schedule.find(s => s.day === day && s.periodNum === periodNum && s.teacherId === teacherId);
      if (conflict) {
        const teacher = teachers.find(t => t.id === teacherId);
        alert(`تعارض برلمجي! المعلم (${teacher ? teacher.name : ''}) يدرس بالفعل صف (${conflict.grade}) في ${day} - الحصة رقم (${periodNum}).`);
        return;
      }

      schedule.push({ id: 's_' + Date.now(), day, periodNum, grade, subject, teacherId });
      saveData();
      closeModal('period-modal');
      renderSchedule();
    }

    function deletePeriod(id) {
      if (confirm('هل أنت تأكد من رغبتك في حذف هذه الحصة؟')) {
        schedule = schedule.filter(s => s.id !== id);
        saveData();
        renderSchedule();
      }
    }

    function resetAllScheduleData() {
      if (confirm('تحذير: هل تريد حقاً تصفير الجدول الدراسي بالكامل؟')) {
        schedule = [];
        saveData();
        renderSchedule();
      }
    }

    function autoScheduleGen() {
      let conflicts = [];
      for (let i = 0; i < schedule.length; i++) {
        for (let j = i + 1; j < schedule.length; j++) {
          if (schedule[i].day === schedule[j].day && 
              schedule[i].periodNum === schedule[j].periodNum && 
              schedule[i].teacherId === schedule[j].teacherId) {
            const t = teachers.find(x => x.id === schedule[i].teacherId);
            conflicts.push(`المعلم (${t ? t.name : ''}) محجوز لصفين (${schedule[i].grade}) و (${schedule[j].grade}) في يوم ${schedule[i].day} الحصة ${schedule[i].periodNum}`);
          }
        }
      }
      if (conflicts.length > 0) {
        alert("تم اكتشاف التعارضات التالية:\n\n" + conflicts.join("\n"));
      } else {
        alert("ممتاز! لا توجد أي تعارضات في أوقات المعلمين.");
      }
    }

    function renderSettings() {
      const classesContainer = document.getElementById('classes-list-container');
      const periodsContainer = document.getElementById('periods-timing-container');

      classesContainer.innerHTML = classes.map(c => `
        <div class="flex justify-between items-center bg-slate-50 border border-slate-200 p-3 rounded-xl">
          <span class="font-bold text-slate-800 text-sm"><i class="fa-solid fa-graduation-cap text-sky-600 ml-2"></i> ${c.name}</span>
          <button onclick="removeClass('${c.id}')" class="text-rose-500 hover:text-rose-700 text-xs px-2 py-1 rounded-lg bg-rose-50"><i class="fa-solid fa-trash"></i> حذف</button>
        </div>
      `).join('');

      let timingsHTML = `<h4 class="font-bold text-xs text-slate-500 uppercase tracking-wider mb-2">توقيتات الحصص الدراسية</h4>`;
      timingsHTML += periods.map(p => `
        <div class="flex items-center justify-between bg-slate-50 border border-slate-200 p-3 rounded-xl text-sm">
          <span class="font-bold text-slate-800">${p.name}</span>
          <div class="flex items-center gap-2">
            <input type="text" value="${p.start}" onchange="updatePeriodTime(${p.num}, 'start', this.value)" class="bg-white border rounded-lg px-2 py-1 text-xs font-mono w-24 text-center">
            <span class="text-slate-400">-</span>
            <input type="text" value="${p.end}" onchange="updatePeriodTime(${p.num}, 'end', this.value)" class="bg-white border rounded-lg px-2 py-1 text-xs font-mono w-24 text-center">
          </div>
        </div>
      `).join('');

      timingsHTML += `<h4 class="font-bold text-xs text-amber-600 uppercase tracking-wider mt-5 mb-2"><i class="fa-solid fa-mug-hot"></i> الاستراحات والفرص المدخلة</h4>`;
      if (breaks.length > 0) {
        timingsHTML += breaks.map(b => `
          <div class="flex justify-between items-center bg-amber-50 border border-amber-200 p-3 rounded-xl text-sm">
            <div>
              <span class="font-bold text-amber-900 block">${b.name} (${b.time})</span>
              <span class="text-xs text-amber-700">تأتي بعد الحصة رقم: ${b.afterPeriod}</span>
            </div>
            <button onclick="removeBreak('${b.id}')" class="text-rose-600 hover:text-rose-800 text-xs bg-white px-2.5 py-1 rounded-lg border border-amber-200"><i class="fa-solid fa-trash"></i> حذف</button>
          </div>
        `).join('');
      } else {
        timingsHTML += `<p class="text-xs text-slate-400 italic">لا توجد استراحات مضافة حالياً.</p>`;
      }

      periodsContainer.innerHTML = timingsHTML;
    }

    function saveBreak(e) {
      e.preventDefault();
      const name = document.getElementById('break-name-input').value.trim();
      const time = document.getElementById('break-time-input').value.trim();
      const afterPeriod = parseInt(document.getElementById('break-after-period').value);

      if (name && time) {
        breaks.push({ id: 'b_' + Date.now(), name, time, afterPeriod });
        saveData();
        closeModal('break-modal');
        renderSettings();
      }
    }

    function removeBreak(id) {
      if (confirm('هل أنت متأكد من حذف هذه الاستراحة؟')) {
        breaks = breaks.filter(b => b.id !== id);
        saveData();
        renderSettings();
      }
    }

    function openAddClassModal() {
      document.getElementById('class-name-input').value = '';
      openModal('class-modal');
    }

    function saveClass(e) {
      e.preventDefault();
      const name = document.getElementById('class-name-input').value.trim();
      if (name) {
        classes.push({ id: 'c_' + Date.now(), name });
        saveData();
        populateModalDropdowns();
        closeModal('class-modal');
        renderSettings();
      }
    }

    function removeClass(id) {
      if (confirm('هل أنت متأكد من حذف هذه الشعبة؟')) {
        classes = classes.filter(c => c.id !== id);
        saveData();
        populateModalDropdowns();
        renderSettings();
      }
    }

    function updatePeriodTime(num, key, val) {
      const period = periods.find(p => p.num === num);
      if (period) {
        period[key] = val;
        saveData();
      }
    }

    function renderStaff() {
      const grid = document.getElementById('staff-cards-grid');
      grid.innerHTML = teachers.map(t => {
        const count = schedule.filter(s => s.teacherId === t.id).length;
        return `
          <div class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200 space-y-3">
            <div class="flex justify-between items-start">
              <div>
                <h3 class="font-extrabold text-slate-800 text-lg">${t.name}</h3>
                <p class="text-xs font-semibold text-sky-600 bg-sky-50 inline-block px-2.5 py-1 rounded-lg border border-sky-100 mt-1">${t.subject}</p>
              </div>
              <span class="bg-amber-100 text-amber-800 text-xs font-black px-2.5 py-1 rounded-full border border-amber-200">${count} حصة</span>
            </div>
            <div class="text-xs text-slate-500 pt-2 border-t border-slate-100 flex justify-between items-center">
              <span><i class="fa-solid fa-phone text-slate-400"></i> ${t.phone || 'غير مسجل'}</span>
              <button onclick="deleteStaff('${t.id}')" class="text-rose-500 hover:text-rose-700 text-xs font-bold"><i class="fa-solid fa-user-xmark"></i> حذف</button>
            </div>
          </div>
        `;
      }).join('');
    }

    function saveStaffMember(e) {
      e.preventDefault();
      const name = document.getElementById('staff-name').value.trim();
      const subject = document.getElementById('staff-subject').value.trim();
      const phone = document.getElementById('staff-phone').value.trim();
      if (name && subject) {
        teachers.push({ id: 't_' + Date.now(), name, subject, phone });
        saveData();
        populateModalDropdowns();
        closeModal('staff-modal');
        renderStaff();
      }
    }

    function deleteStaff(id) {
      if (confirm('هل أنت متأكد من حذف هذا المعلم؟')) {
        teachers = teachers.filter(t => t.id !== id);
        schedule = schedule.filter(s => s.teacherId !== id);
        saveData();
        populateModalDropdowns();
        renderStaff();
      }
    }

    function exportStaffToExcel() {
      const data = teachers.map(t => ({
        "الاسم الكامل": t.name,
        "التخصص": t.subject,
        "رقم الهاتف": t.phone,
        "عدد الحصص الأسبوعية": schedule.filter(s => s.teacherId === t.id).length
      }));
      const ws = XLSX.utils.json_to_sheet(data);
      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, ws, "الكادر");
      XLSX.writeFile(wb, "كادر_مدرسة_الباسط.xlsx");
    }

    function importStaffFromExcel(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(evt) {
        const data = XLSX.utils.sheet_to_json(XLSX.read(evt.target.result, { type: 'binary' }).Sheets[XLSX.read(evt.target.result, { type: 'binary' }).SheetNames[0]]);
        data.forEach(row => {
          const name = row["الاسم الكامل"] || row["اسم المعلم"];
          const subject = row["التخصص"] || "عام";
          const phone = row["رقم الهاتف"] || "";
          if (name && !teachers.some(t => t.name === name)) {
            teachers.push({ id: 't_' + Date.now() + Math.random(), name, subject, phone });
          }
        });
        saveData();
        populateModalDropdowns();
        renderStaff();
        alert("تم استيراد الكادر بنجاح.");
      };
      reader.readAsBinaryString(file);
    }

    function renderAbsenceView() {
      const select = document.getElementById('absent-teacher-select');
      select.innerHTML = teachers.map(t => `<option value="${t.id}">${t.name} (${t.subject})</option>`).join('');
    }

    function handleAbsenceSubmit(e) {
      e.preventDefault();
      const absentId = document.getElementById('absent-teacher-select').value;
      const absentTeacher = teachers.find(t => t.id === absentId);
      const container = document.getElementById('substitutions-list');
      const todayArabic = daysOfWeek[new Date().getDay()] || 'الأحد';
      const affectedPeriods = schedule.filter(s => s.teacherId === absentId && s.day === todayArabic);

      if (affectedPeriods.length === 0) {
        container.innerHTML = `<div class="p-4 bg-emerald-50 text-emerald-800 rounded-xl text-sm font-bold text-center">لا توجد حصص لهذا المعلم في يوم ${todayArabic}.</div>`;
        return;
      }

      let html = `<div class="mb-3 font-bold text-slate-800 text-sm">الحصص المتأثرة اليوم للمعلم: <span class="text-rose-600">${absentTeacher.name}</span></div>`;
      affectedPeriods.forEach(p => {
        const busyIds = schedule.filter(s => s.day === todayArabic && s.periodNum === p.periodNum).map(s => s.teacherId);
        const available = teachers.filter(t => t.id !== absentId && !busyIds.includes(t.id));
        html += `
          <div class="bg-slate-50 border p-3 rounded-xl space-y-2 text-xs">
            <div class="font-extrabold text-sky-900">${p.grade} - الحصة ${p.periodNum} (${p.subject})</div>
            <div class="flex flex-wrap gap-1">
              ${available.length > 0 ? available.map(t => `<span class="bg-white border px-2 py-1 rounded font-semibold">${t.name}</span>`).join('') : '<span class="text-rose-500">لا يوجد معلّمون شاغرون</span>'}
            </div>
          </div>
        `;
      });
      container.innerHTML = html;
    }

    function renderAnalytics() {
      const ctxSubjects = document.getElementById('chart-subjects').getContext('2d');
      const ctxTeachers = document.getElementById('chart-teachers').getContext('2d');

      const subjectCounts = {};
      schedule.forEach(s => { subjectCounts[s.subject] = (subjectCounts[s.subject] || 0) + 1; });

      const teacherCounts = teachers.map(t => ({
        name: t.name,
        count: schedule.filter(s => s.teacherId === t.id).length
      }));

      if (chartSubjectsInstance) chartSubjectsInstance.destroy();
      if (chartTeachersInstance) chartTeachersInstance.destroy();

      chartSubjectsInstance = new Chart(ctxSubjects, {
        type: 'pie',
        data: {
          labels: Object.keys(subjectCounts).length ? Object.keys(subjectCounts) : ['لا توجد بيانات'],
          datasets: [{ data: Object.values(subjectCounts).length ? Object.values(subjectCounts) : [1], backgroundColor: ['#0284c7', '#f59e0b', '#10b981', '#6366f1', '#ec4899', '#8b5cf6', '#14b8a6', '#f97316'] }]
        },
        options: { responsive: true, maintainAspectRatio: false }
      });

      chartTeachersInstance = new Chart(ctxTeachers, {
        type: 'bar',
        data: {
          labels: teacherCounts.map(t => t.name),
          datasets: [{ label: 'عدد الحصص', data: teacherCounts.map(t => t.count), backgroundColor: '#0284c7' }]
        },
        options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true } } }
      });
    }

    function renderTVView() {
      const todayArabic = daysOfWeek[new Date().getDay()] || 'الأحد';
      document.getElementById('tv-current-day-title').textContent = `اليوم: ${todayArabic}`;
      const grid = document.getElementById('tv-active-classes-grid');
      const activePeriods = schedule.filter(s => s.day === todayArabic && s.periodNum === 1);
      grid.innerHTML = activePeriods.length ? activePeriods.map(s => {
        const teacher = teachers.find(t => t.id === s.teacherId);
        return `<div class="bg-slate-800 border border-slate-700 p-4 rounded-2xl"><div class="text-amber-400 font-extrabold">${s.grade}</div><div class="text-white text-lg font-bold">${s.subject}</div><div class="text-slate-400 text-xs mt-1">${teacher ? teacher.name : ''}</div></div>`;
      }).join('') : '<div class="col-span-full text-center text-slate-500 py-6">لا توجد حصص قائمة الآن.</div>';
    }

    function updateClock() {
      const now = new Date();
      document.getElementById('live-time-display').textContent = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true });
      document.getElementById('print-date').textContent = now.toLocaleDateString('ar-IQ', { year: 'numeric', month: 'long', day: 'numeric' });
    }

    function toggleBellSound() {
      isBellActive = !isBellActive;
      document.getElementById('bell-status').textContent = isBellActive ? 'مفعل' : 'معطل';
    }

    window.addEventListener('DOMContentLoaded', () => {
      saveData();
      populateModalDropdowns();
      renderSchedule();
      setInterval(updateClock, 1000);
      updateClock();
    });
  </script>
</body>
</html>
